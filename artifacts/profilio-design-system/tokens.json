  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Body, UI, labels, and supporting text."
      },
      "serif": {
        "$value": ["Plus Jakarta Sans", "sans-serif"],
        "$description": "Profilio's display/heading face, mapped to the scaffold's serif slot."
      },
      "mono": {
        "$value": ["SFMono-Regular", "Consolas", "monospace"],
        "$description": "Metrics, counts, and compact data labels."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "8px base radius; larger surfaces commonly use the derived xl 12px treatment."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "4px base rhythm used for compact controls, cards, and page layout."
    }
  }
