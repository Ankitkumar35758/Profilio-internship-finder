      "primaryForeground": { "$value": "#FBF9F5" },
      "secondary": { "$value": "#E8F0E6", "$description": "Soft sage support surface." },
      "secondaryForeground": { "$value": "#315247" },
      "muted": { "$value": "#F0ECE3" },
      "mutedForeground": { "$value": "#557066" },
