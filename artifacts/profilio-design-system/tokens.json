  "$description": "Profilio's visual language: a warm cream canvas, deep forest navigation, editorial green typography, and soft peach and marigold signals. Extracted from artifacts/profilio/src/index.css and its shared UI patterns. Edit this file only; generated CSS and token modules are derived outputs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FBF9F5", "$description": "Warm cream page canvas." },
      "foreground": { "$value": "#24453B", "$description": "Deep green default text." },
      "border": { "$value": "#DED9CF", "$description": "Warm neutral border." },
